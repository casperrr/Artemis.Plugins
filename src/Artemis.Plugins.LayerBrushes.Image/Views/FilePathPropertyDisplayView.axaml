<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Artemis.Plugins.LayerBrushes.Image.ViewModels;assembly=Artemis.Plugins.LayerBrushes.Image"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Artemis.Plugins.LayerBrushes.Image.Views.FilePathPropertyDisplayView"
             x:DataType="vm:FilePathPropertyDisplayViewModel">
  <StackPanel Orientation="Horizontal" Spacing="8">
    <TextBox
      Text="{CompiledBinding InputValue}"
      Watermark="Enter image path or browse" />
  
    <Button
        Classes="accent"
        Command="{CompiledBinding Browse}">
      Browse
    </Button>
  </StackPanel>
</UserControl>
